<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- KettleLAN: permission to create the kettle0 virtual network adapter.
     Applies only to the helper /usr/lib/kettlelan/kettlelan-helper (installed by the .deb package). -->
<policyconfig>
  <vendor>KettleLAN</vendor>
  <vendor_url>https://github.com/maxiuz94/kettlelan</vendor_url>
  <action id="io.github.maxiuz94.kettlelan.helper">
    <description>Create the KettleLAN virtual network adapter</description>
    <description xml:lang="pl">Tworzenie wirtualnej karty sieciowej KettleLAN</description>
    <message>KettleLAN needs to create a virtual network adapter (kettle0) for playing LAN games with friends.</message>
    <message xml:lang="pl">KettleLAN chce utworzyć wirtualną kartę sieciową (kettle0) do gry w sieci LAN ze znajomymi.</message>
    <icon_name>kettlelan</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kettlelan/kettlelan-helper</annotate>
  </action>
</policyconfig>
