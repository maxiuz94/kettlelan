// KettleLAN - Windows resources: application icon and version information.
#include <winver.h>

IDI_ICON1 ICON "kettlelan.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     KETTLELAN_VERSION_MAJOR, KETTLELAN_VERSION_MINOR, KETTLELAN_VERSION_PATCH, 0
PRODUCTVERSION  KETTLELAN_VERSION_MAJOR, KETTLELAN_VERSION_MINOR, KETTLELAN_VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KettleLAN"
            VALUE "FileDescription",  "KettleLAN - virtual LAN over the Steam network"
            VALUE "FileVersion",      KETTLELAN_VERSION_STRING
            VALUE "LegalCopyright",   "BSD-3-Clause, see LICENSE"
            VALUE "ProductName",      "KettleLAN"
            VALUE "ProductVersion",   KETTLELAN_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
