# KettleLAN – Wintun (Windows TUN driver, https://www.wintun.net) – official signed build.
#
# The zip is downloaded from wintun.net and verified with SHA256. wintun.dll (signed by WireGuard LLC)
# is copied next to the program unmodified, together with its license.
set(WINTUN_VERSION 0.14.1)
set(WINTUN_SHA256 07c256185d6ee3652e09fa55c0b673e2624b565e02c4b9091c79ca7d2f24ef51)
set(WINTUN_URL "https://www.wintun.net/builds/wintun-${WINTUN_VERSION}.zip")
set(WINTUN_ZIP "" CACHE FILEPATH "Local copy of wintun-${WINTUN_VERSION}.zip (otherwise it is downloaded)")

set(_wt_dir "${CMAKE_BINARY_DIR}/_deps/wintun")
set(_wt_zip "${WINTUN_ZIP}")
if(NOT _wt_zip)
    set(_wt_zip "${CMAKE_BINARY_DIR}/_deps/wintun-${WINTUN_VERSION}.zip")
    if(NOT EXISTS "${_wt_zip}")
        message(STATUS "Wintun: downloading ${WINTUN_URL}")
        file(DOWNLOAD "${WINTUN_URL}" "${_wt_zip}" EXPECTED_HASH SHA256=${WINTUN_SHA256} STATUS _st)
        list(GET _st 0 _code)
        if(NOT _code EQUAL 0)
            file(REMOVE "${_wt_zip}")
            message(FATAL_ERROR "Could not download Wintun: ${_st}")
        endif()
    endif()
endif()
file(SHA256 "${_wt_zip}" _wt_actual)
if(NOT _wt_actual STREQUAL WINTUN_SHA256)
    message(FATAL_ERROR "Wintun: wrong SHA256 of ${_wt_zip} (${_wt_actual})")
endif()
if(NOT EXISTS "${_wt_dir}/wintun/bin/amd64/wintun.dll")
    file(ARCHIVE_EXTRACT INPUT "${_wt_zip}" DESTINATION "${_wt_dir}")
endif()
set(WINTUN_DLL "${_wt_dir}/wintun/bin/amd64/wintun.dll")
set(WINTUN_LICENSE "${_wt_dir}/wintun/LICENSE.txt")
message(STATUS "Wintun ${WINTUN_VERSION}: ${WINTUN_DLL}")
