#!/bin/sh
# KettleLAN – pomocnik systemowy (Linux). Uruchamiany jako root przez pkexec.
#
#   kettlelan-helper up <uid> <adres>   tworzy kartę kettle0 należącą do użytkownika <uid>
#   kettlelan-helper down               usuwa kartę kettle0
#
# Robi tylko te dwie rzeczy i ściśle sprawdza argumenty, bo działa z uprawnieniami roota.
set -eu

IFACE=kettle0
MTU=1200
PATH=/usr/sbin:/usr/bin:/sbin:/bin

die() { echo "kettlelan-helper: $*" >&2; exit 2; }

[ "$(id -u)" -eq 0 ] || die "musi działać jako root (przez pkexec)"
command -v ip >/dev/null 2>&1 || die "brak polecenia ip (pakiet iproute2)"

case "${1:-}" in
up)
    [ $# -eq 3 ] || die "użycie: up <uid> <adres>"
    uid=$2
    addr=$3
    case "$uid" in ''|*[!0-9]*) die "nieprawidłowy uid" ;; esac
    # adres musi leżeć w 100.64.0.0/10, czyli 100.64.x.x – 100.127.x.x
    echo "$addr" | grep -Eq '^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.([0-9]{1,3})\.([0-9]{1,3})$' \
        || die "nieprawidłowy adres"
    for octet in $(echo "$addr" | cut -d. -f3-4 | tr . ' '); do
        [ "$octet" -le 255 ] || die "nieprawidłowy adres"
    done

    ip link del "$IFACE" 2>/dev/null || true
    ip tuntap add dev "$IFACE" mode tun user "$uid"
    ip addr add "$addr/10" broadcast + dev "$IFACE"
    ip link set dev "$IFACE" mtu "$MTU" up
    echo "kettlelan-helper: karta $IFACE gotowa ($addr/10)"
    ;;
down)
    ip link del "$IFACE" 2>/dev/null || true
    echo "kettlelan-helper: karta $IFACE usunięta"
    ;;
*)
    die "użycie: up <uid> <adres> | down"
    ;;
esac
