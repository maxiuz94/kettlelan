#!/bin/sh
# KettleLAN – system helper (Linux). Started as root through pkexec (or sudo).
#
#   kettlelan-helper up <uid> <address>      creates the kettle0 adapter owned by user <uid>
#   kettlelan-helper down                    removes the kettle0 adapter
#   kettlelan-helper check <uid> <address>   only validates the arguments (no root, for tests)
#
# It does only these things and validates its arguments strictly, because it runs as root.
set -eu

IFACE=kettle0
MTU=1200
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

die() { echo "kettlelan-helper: $*" >&2; exit 2; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "must run as root (through pkexec)"
    command -v ip >/dev/null 2>&1 || die "the ip command is missing (iproute2 package)"
}

# Validates uid and address. Anything that does not match the pattern exactly is rejected.
validate() {
    uid=$1
    addr=$2
    case "$uid" in ''|*[!0-9]*) die "invalid uid" ;; esac
    [ "${#uid}" -le 10 ] || die "invalid uid"
    # uid must belong to an existing regular account (not root or a system account)
    [ "$uid" -ge 1000 ] || die "invalid uid"
    getent passwd "$uid" >/dev/null 2>&1 || die "unknown user"
    # the address must be inside 100.64.0.0/10 (100.64.x.x – 100.127.x.x), without leading zeros
    oct='(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
    case "$addr" in *"
"*) die "invalid address" ;; esac
    printf '%s' "$addr" | grep -Eqx "100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.$oct\\.$oct" \
        || die "invalid address"
}

case "${1:-}" in
up)
    [ $# -eq 3 ] || die "usage: up <uid> <address>"
    need_root
    validate "$2" "$3"
    ip link del "$IFACE" 2>/dev/null || true
    ip tuntap add dev "$IFACE" mode tun user "$uid"
    ip addr add "$addr/10" broadcast + dev "$IFACE"
    ip link set dev "$IFACE" mtu "$MTU" up
    echo "kettlelan-helper: adapter $IFACE ready ($addr/10)"
    ;;
down)
    [ $# -eq 1 ] || die "usage: down"
    need_root
    ip link del "$IFACE" 2>/dev/null || true
    echo "kettlelan-helper: adapter $IFACE removed"
    ;;
check)
    [ $# -eq 3 ] || die "usage: check <uid> <address>"
    validate "$2" "$3"
    echo "OK"
    ;;
*)
    die "usage: up <uid> <address> | down | check <uid> <address>"
    ;;
esac
